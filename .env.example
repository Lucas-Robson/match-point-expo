# Provedor de dados: memory durante o desenvolvimento inicial, firebase na integração.
EXPO_PUBLIC_DATA_PROVIDER=memory

# Configuração pública do aplicativo Firebase.
# Nunca coloque contas de serviço, chaves privadas ou senhas neste arquivo.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
